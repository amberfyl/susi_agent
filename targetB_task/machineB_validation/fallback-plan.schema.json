{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "machineb.fallback_plan.v1",
  "title": "Machine-B fallback convergence plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "run_id", "baseline", "sections"],
  "properties": {
    "schema_version": {"const": "machineb.fallback_plan.v1"},
    "project": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary_path", "summary_sha256", "full_ini_path", "full_ini_sha256"],
      "properties": {
        "summary_path": {"type": "string", "minLength": 1},
        "summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "full_ini_path": {"type": "string", "minLength": 1},
        "full_ini_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section", "status", "trigger_code", "trigger_reason",
          "baseline_route", "route_field", "route_candidates", "option_fallback_enabled",
          "success_condition", "passed_channels", "failed_channels",
          "baseline_report_path", "baseline_report_sha256"
        ],
        "properties": {
          "section": {"type": "string", "minLength": 1},
          "status": {"enum": ["PLANNED", "NO_ALTERNATIVE_CANDIDATE"]},
          "trigger_code": {
            "enum": [
              "EXPECTED_SECTION_ALL_CHANNEL_API_FAILED",
              "EXPECTED_GPIO_ROUTE_PROBES_ALL_FAILED"
            ]
          },
          "trigger_reason": {"type": "string", "minLength": 1},
          "baseline_route": {"type": "string", "minLength": 1},
          "route_field": {"const": "IOPort/Address"},
          "route_candidates": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "option_fallback_enabled": {"const": false},
          "success_condition": {
            "enum": [
              "ANY_CHANNEL_API_SUCCEEDED",
              "GPIO_CAPS_READS_OK_AND_MAJORITY_PINS_SUPPORTED"
            ]
          },
          "passed_channels": {"type": "array", "maxItems": 0},
          "failed_channels": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "baseline_report_path": {"type": "string", "minLength": 1},
          "baseline_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "allOf": [
          {
            "if": {
              "properties": {"section": {"const": "GPIO"}},
              "required": ["section"]
            },
            "then": {
              "properties": {
                "trigger_code": {"const": "EXPECTED_GPIO_ROUTE_PROBES_ALL_FAILED"},
                "success_condition": {"const": "GPIO_CAPS_READS_OK_AND_MAJORITY_PINS_SUPPORTED"}
              }
            },
            "else": {
              "properties": {
                "trigger_code": {"const": "EXPECTED_SECTION_ALL_CHANNEL_API_FAILED"},
                "success_condition": {"const": "ANY_CHANNEL_API_SUCCEEDED"}
              }
            }
          }
        ]
      }
    }
  }
}
